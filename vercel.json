{
  "version": 2,
  "buildCommand": null,
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/ai", "destination": "/api/ai.js" },
    { "source": "/api/search", "destination": "/api/search.js" },
    { "source": "/api/suggest", "destination": "/api/suggest.js" },
    { "source": "/api/languages", "destination": "/api/languages.js" }
  ]
}
